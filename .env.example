# ── AI Provider ──────────────────────────────────────────────────────────────
# Choose Anthropic (Claude) or OpenAI
ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-...

# Claude model to use (default: claude-sonnet-4-6)
# AI_MODEL=claude-sonnet-4-6

# AI provider override (default: anthropic)
# AI_PROVIDER=anthropic

# ── Firecrawl (for web search & news) ────────────────────────────────────────
# Get a free API key at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./autoresearcher.db
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ── Scheduler ─────────────────────────────────────────────────────────────────
ENABLE_SCHEDULER=true
DAILY_FETCH_HOUR=8   # UTC hour for daily auto-fetch

# ── CORS (comma-separated origins for frontend) ───────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","https://your-domain.com"]
